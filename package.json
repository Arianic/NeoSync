{
  "name": "neosync",
  "productName": "NeoSync",
  "version": "1.3.3-beta.7",
  "description": "A local-first writing app with built-in Nextcloud synchronization, based on Neo.",
  "homepage": "https://github.com/Arianic/NeoSync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:spellcheck": "node --test scripts/spellcheck.test.js",
    "test:dashes": "node --test scripts/dashes.test.js",
    "test:words": "electron scripts/words.e2e.js",
    "test:tabs": "electron scripts/tabs.e2e.js",
    "test:caret": "electron scripts/caret.e2e.js",
    "test": "node --test \"scripts/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"scripts/*.test.js\"",
    "lint": "oxlint",
    "release": "node scripts/release.js",
    "package": "npm run package:mac",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win --publish never",
    "package:linux": "electron-builder --linux --publish never",
    "package:all": "electron-builder --mac --win --linux",
    "test:sync": "node --test scripts/sync.test.js",
    "test:sync:desktop": "electron scripts/sync.e2e.js",
    "package:linux:x64": "electron-builder --linux --x64 --publish never",
    "package:linux:arm64": "electron-builder --linux --arm64 --publish never",
    "test:sync:keyring": "electron scripts/sync-keyring.e2e.js",
    "test:sync:restart": "node scripts/sync-restart.e2e.js",
    "test:sync:ui": "electron scripts/sync-ui.e2e.js",
    "test:updates": "electron scripts/updates.e2e.js"
  },
  "build": {
    "appId": "personal.neosync.desktop",
    "productName": "NeoSync",
    "publish": {
      "provider": "generic",
      "url": "https://github.com/Arianic/NeoSync/releases/latest/download",
      "channel": "latest",
      "useMultipleRangeRequest": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "synopsis": "A distraction-free word processor for authors",
      "desktop": {
        "entry": {
          "Comment": "A word processor for authors. Distraction-free by default.",
          "Keywords": "writing;writer;novel;book;author;manuscript;wordprocessor;"
        }
      },
      "maintainer": "Arianic",
      "executableName": "neosync",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "asarUnpack": [
      "node_modules/dictionary-ro/**",
      "node_modules/dictionary-pt/**",
      "node_modules/dictionary-hu/**",
      "node_modules/dictionary-sv/**"
    ],
    "extraResources": [
      {
        "from": "licenses/dictionary-sv",
        "to": "app.asar.unpacked/node_modules/dictionary-sv"
      },
      {
        "from": "licenses/dictionary-ro",
        "to": "app.asar.unpacked/node_modules/dictionary-ro"
      },
      {
        "from": "licenses/dictionary-pt",
        "to": "app.asar.unpacked/node_modules/dictionary-pt"
      },
      {
        "from": "licenses/hunspell",
        "to": "licenses/hunspell"
      }
    ],
    "files": [
      "**/*",
      "!pocket/**",
      "!dist/**",
      "!Backups/**",
      "!*.md",
      "!.github/**",
      "!scripts/**",
      "!licenses/**",
      "!Claude outputs/**",
      "!dictionaries/**",
      "!locales/_template.json",
      "!node_modules/koffi/build/koffi/{freebsd,linux,musl,openbsd,win32}_*/**",
      "!node_modules/koffi/{src,vendor,doc}/**"
    ],
    "detectUpdateChannel": false,
    "toolsets": {
      "appimage": "1.0.3"
    }
  },
  "author": "Hugh Howey",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.3.2",
    "oxlint": "^1.86.0"
  },
  "dependencies": {
    "@farscrl/hunspell-wasm": "1.0.1",
    "dictionary-de": "^3.0.0",
    "dictionary-el": "^4.0.0",
    "dictionary-en-au": "^3.0.0",
    "dictionary-en-ca": "^3.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-en-us": "^2.2.1",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-hu": "file:dictionaries/hu",
    "dictionary-nl": "^2.0.0",
    "dictionary-pl": "^2.0.0",
    "dictionary-pt": "4.0.0",
    "dictionary-ro": "3.0.0",
    "dictionary-ru": "^3.0.0",
    "dictionary-sv": "4.0.0",
    "electron-updater": "^6.3.9",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.1",
    "koffi": "2.16.3",
    "semver": "^7.8.5"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "desktopName": "neosync.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arianic/NeoSync.git"
  },
  "bugs": {
    "url": "https://github.com/Arianic/NeoSync/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
